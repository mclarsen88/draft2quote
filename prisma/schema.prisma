generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model Workspace { id String @id @default(cuid()) name String stores Store[] quotes Quote[] createdAt DateTime @default(now()) }
model Store { id String @id @default(cuid()) workspaceId String name String publicDomain String myShopifyDomain String? approvedHosts Json logoUrl String? primaryColor String secondaryColor String businessInfo Json defaultTerms String defaultValidityDays Int parserRules Json? workspace Workspace @relation(fields:[workspaceId], references:[id]) quotes Quote[] }
model Quote { id String @id @default(cuid()) workspaceId String storeId String quoteNumber String? sourceOrderNumber String? customerName String? company String? totalMinor Int? currency String? status String @default("needs_review") sourceUrlRedacted String checkoutUrlEncrypted String? parserVersion String retrievalMethod String? renderedWithBrowser Boolean @default(false) extractionConfidence String extractionWarnings Json manualModified Boolean @default(false) pdfStatus String @default("not_generated") quoteData Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt workspace Workspace @relation(fields:[workspaceId], references:[id]) store Store @relation(fields:[storeId], references:[id]) }
